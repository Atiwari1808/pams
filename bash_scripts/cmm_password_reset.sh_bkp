#!/bin/bash
# ==============================================================
# cmm_password_reset.sh (Django Integrated & Automated)
# ==============================================================
# Called by Django as:
#   bash cmm_password_reset.sh <input.csv> <output.csv>
#
# Input CSV Format:
#   NodeIP, NodeType, Username, OldPassword, NewPassword
#
# Supports TWO node formats:
#
#   FORMAT A � CMM Custom Shell (Restricted Shell)
#     Flow: ssh ? Banner ? Password ? '>' prompt ? passwd
#           ? Old Password ? New Password ? Retype ? Success
#
#   FORMAT B � CMM Linux Shell (Full Bash + LDAP)
#     Flow: ssh ? ECDSA yes/no ? Banner ? password
#           ? Last login info ? [user@host ~]$ prompt ? passwd
#           ? (current) LDAP Password ? New user password
#           ? Retype new user password ? Success
#
# NodeType column in CSV determines format:
#   Use "CMM_SHELL"  for Format A (restricted shell / '>' prompt)
#   Use "CMM_LINUX"  for Format B (full bash / LDAP passwd)
#   Leave blank or "AUTO" to attempt auto-detection
# ==============================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/common.sh"
pams_init "$@"
pams_check_deps expect ssh

MAX_RETRY=1
MAX_PARALLEL=3
TIMEOUT=45

# Initialize output CSV with header
echo "NodeIP,NodeType,Username,Status,Reason,Attempts,Timestamp,LogFile" > "$OUTPUT_CSV"

# Lock file for thread-safe CSV writes
CSV_LOCK="${OUTPUT_CSV}.lock"

# ================================
# PARSE INPUT CSV
# ================================
PARSED_FILE=$(mktemp)
DELIM=","
head -n 1 "$INPUT_CSV" | grep -qP '\t' && DELIM=$'\t'

tail -n +2 "$INPUT_CSV" | tr -d '\r' | while IFS="$DELIM" read -r IP TYPE USER OLD_PASS NEW_PASS _REST; do
    IP=$(echo "$IP" | xargs)
    [[ -z "$IP" ]] && continue
    echo "$IP|$TYPE|$USER|$OLD_PASS|$NEW_PASS" >> "$PARSED_FILE"
done

TOTAL_NODES=$(wc -l < "$PARSED_FILE")
echo ">>> Starting CMM Password Reset for $TOTAL_NODES nodes (Parallel: $MAX_PARALLEL)"
echo ">>> Logs: $LOG_DIR"
echo "====================================================================="

# ================================
# FORMAT A � CMM RESTRICTED SHELL
# Prompt flow:
#   ssh ? Banner(*) ? Password: ? '>' ? passwd
#   ? Old Password: ? New Password: ? Retype: ? successfully
# ================================
run_format_a() {
    local NODE_IP="$1"
    local USERNAME="$2"
    local OLD_PASS="$3"
    local NEW_PASS="$4"
    local NODE_LOG="$5"

    expect -c "
        log_file -a \"$NODE_LOG\"
        set timeout $TIMEOUT
        exp_internal 0

        # Use braces to safely handle special characters in passwords
        set old_pass {$OLD_PASS}
        set new_pass {$NEW_PASS}

        # No -T here � CMM restricted shell nodes require a PTY.
        # Without PTY the server closes connection immediately (EOF/exit 17).
        spawn ssh -o StrictHostKeyChecking=no \
                  -o UserKnownHostsFile=/dev/null \
                  -o ConnectTimeout=10 \
                  -o NumberOfPasswordPrompts=1 \
                  $USERNAME@$NODE_IP

        # --- STAGE 1: INITIAL LOGIN ---
        # Handle: ECDSA fingerprint, banners, then Password prompt
        expect {
            -nocase \"yes/no\"                    { send \"yes\r\"; exp_continue }
            -nocase \"yes/no/\[fingerprint\]\"    { send \"yes\r\"; exp_continue }
            -nocase \"permission denied\"          { exit 13 }
            -nocase \"authentication failed\"      { exit 13 }
            -nocase \"connection refused\"         { exit 11 }
            -nocase \"no route to host\"           { exit 10 }
            -nocase \"password:\"                  { send \"\$old_pass\r\" }
            timeout                                { exit 10 }
            eof                                    { exit 17 }
        }

        # --- STAGE 2: WAIT FOR SHELL PROMPT '>' ---
        # Debug revealed actual prompt sequence is \u0003> (ETX + >)
        # i.e. Ctrl+C character (0x03) followed by '>'.
        # None of the \n> or \r> patterns match this � must match \x03>
        # Also keep \n> and \r> as fallback for other node variants.
        expect {
            -nocase \"permission denied\"          { exit 13 }
            -nocase \"incorrect password\"         { exit 13 }
            -re \"\x03>\"                          { send \"passwd\r\" }
            -re \"\n> \"                           { send \"passwd\r\" }
            -re \"\n>\"                            { send \"passwd\r\" }
            -re \"\r> \"                           { send \"passwd\r\" }
            timeout                                { exit 20 }
            eof                                    { exit 17 }
        }

        # --- STAGE 3: Old Password prompt ---
        # Match: 'Old Password:' or 'Current Password:'
        expect {
            -nocase \"old password:\"              { send \"\$old_pass\r\" }
            -nocase \"current.*password:\"         { send \"\$old_pass\r\" }
            -nocase \"bad password\"               { exit 22 }
            timeout                                { exit 21 }
            eof                                    { exit 17 }
        }

        # --- STAGE 4: New Password prompt ---
        # Match loosely on 'password:' � at this point in the flow
        # we are inside passwd so any password: prompt = new password.
        # Loose match also handles ANSI codes breaking 'new.*password:'.
        expect {
            -nocase \"bad password\"               { exit 22 }
            -nocase \"password:\"                  { send \"\$new_pass\r\" }
            timeout                                { exit 21 }
            eof                                    { exit 17 }
        }

        # --- STAGE 5: Retype / Confirm prompt ---
        # Same loose match strategy � any password: at this stage = retype
        expect {
            -nocase \"bad password\"               { exit 22 }
            -nocase \"password:\"                  { send \"\$new_pass\r\" }
            timeout                                { exit 21 }
            eof                                    { exit 17 }
        }

        # --- STAGE 6: Verify Result ---
        expect {
            -nocase \"successfully\"               { send \"exit\r\"; exit 0 }
            -nocase \"bad password\"               { exit 22 }
            -nocase \"token manipulation\"         { exit 23 }
            -nocase \"passwd: error\"              { exit 24 }
            -re \"\r\n>\\s*\"                      { exit 24 }
            -re \"\n>\\s*\"                        { exit 24 }
            timeout                                { exit 21 }
            eof                                    { exit 17 }
        }
    "
    return $?
}

# ================================
# FORMAT B � CMM LINUX (LDAP passwd)
# Prompt flow:
#   ssh ? yes/no (ECDSA) ? Airtel Banner ? password:
#   ? Last login info ? CMM info banner ? [user@host ~]$
#   ? passwd ? (current) LDAP Password: ? New user password:
#   ? Retype new user password: ? updated successfully
# ================================
run_format_b() {
    local NODE_IP="$1"
    local USERNAME="$2"
    local OLD_PASS="$3"
    local NEW_PASS="$4"
    local NODE_LOG="$5"

    expect -c "
        log_file -a \"$NODE_LOG\"
        set timeout $TIMEOUT

        set old_pass {$OLD_PASS}
        set new_pass {$NEW_PASS}

        spawn ssh -o StrictHostKeyChecking=no \
                  -o UserKnownHostsFile=/dev/null \
                  -o ConnectTimeout=10 \
                  -o NumberOfPasswordPrompts=1 \
                  $USERNAME@$NODE_IP

        # --- STAGE 1: ECDSA + Banners + SSH Password ---
        expect {
            -nocase \"yes/no\"                    { send \"yes\r\"; exp_continue }
            -nocase \"yes/no/\[fingerprint\]\"    { send \"yes\r\"; exp_continue }
            -nocase \"permission denied\"          { exit 13 }
            -nocase \"authentication failed\"      { exit 13 }
            -nocase \"connection refused\"         { exit 11 }
            -nocase \"no route to host\"           { exit 10 }
            -re -nocase \"${USERNAME}.*password:\" { send \"\$old_pass\r\" }
            -nocase \"password:\"                  { send \"\$old_pass\r\" }
            timeout                                { exit 10 }
            eof                                    { exit 17 }
        }

        # --- STAGE 2: Post-login banners ? bash prompt ---
        # Node sends: Last login, CMM info block, then [user@host ~]$
        expect {
            -nocase \"permission denied\"   { exit 13 }
            -nocase \"incorrect password\"  { exit 13 }
            -re {\\\$\s*$}                  { send \"passwd\r\" }
            -re {\[.*@.*\]\s*\\\$}          { send \"passwd\r\" }
            timeout                         { exit 20 }
            eof                             { exit 17 }
        }

        # --- STAGE 3: (current) LDAP Password ---
        expect {
            -nocase \"current.*password:\"  { send \"\$old_pass\r\" }
            -nocase \"ldap password:\"      { send \"\$old_pass\r\" }
            -nocase \"old password:\"       { send \"\$old_pass\r\" }
            -nocase \"bad password\"        { exit 22 }
            timeout                         { exit 21 }
            eof                             { exit 17 }
        }

        # --- STAGE 4: New user password ---
        expect {
            -nocase \"new.*password:\"      { send \"\$new_pass\r\" }
            -nocase \"bad password\"        { exit 22 }
            -nocase \"authentication token\" { exit 13 }
            timeout                         { exit 21 }
            eof                             { exit 17 }
        }

        # --- STAGE 5: Retype new user password ---
        expect {
            -nocase \"retype.*password:\"   { send \"\$new_pass\r\" }
            -nocase \"re-enter.*password:\" { send \"\$new_pass\r\" }
            -nocase \"confirm.*password:\"  { send \"\$new_pass\r\" }
            -nocase \"bad password\"        { exit 22 }
            timeout                         { exit 21 }
            eof                             { exit 17 }
        }

        # --- STAGE 6: Verify Result ---
        expect {
            -nocase \"updated successfully\" { send \"exit\r\"; exit 0 }
            -nocase \"successfully\"         { send \"exit\r\"; exit 0 }
            -nocase \"bad password\"         { exit 22 }
            -nocase \"token manipulation\"   { exit 23 }
            -nocase \"authentication token\" { exit 23 }
            -nocase \"error\"                { exit 24 }
            -re {\\\$\s*$}                   { exit 24 }
            timeout                          { exit 21 }
            eof                              { exit 17 }
        }
    "
    return $?
}

# ================================
# DECODE EXIT CODE ? STATUS/REASON
# ================================
decode_result() {
    local CODE="$1"
    case "$CODE" in
        0)  echo "SUCCESS|Password Updated Successfully" ;;
        10) echo "FAILED|SSH Timeout / No Route to Host" ;;
        11) echo "FAILED|Connection Refused" ;;
        13) echo "FAILED|Wrong Old Password (Auth Failed)" ;;
        17) echo "FAILED|Connection Closed Unexpectedly (EOF)" ;;
        20) echo "FAILED|Shell Prompt Not Received After Login" ;;
        21) echo "FAILED|Passwd Prompt Timeout" ;;
        22) echo "FAILED|BAD PASSWORD (Weak / Policy Violation)" ;;
        23) echo "FAILED|Token Manipulation / LDAP Auth Error" ;;
        24) echo "FAILED|Unknown Failure (Shell returned without success)" ;;
        *)  echo "FAILED|Unexpected Error (Code: $CODE)" ;;
    esac
}

# ================================
# CORE PROCESS FUNCTION
# ================================
process_node() {
    local LINE="$1"
    local NODE_IP=$(echo "$LINE"   | cut -d'|' -f1)
    local NODE_TYPE=$(echo "$LINE" | cut -d'|' -f2 | tr '[:lower:]' '[:upper:]' | xargs)
    local USERNAME=$(echo "$LINE"  | cut -d'|' -f3)
    local OLD_PASS=$(echo "$LINE"  | cut -d'|' -f4)
    local NEW_PASS=$(echo "$LINE"  | cut -d'|' -f5)

    # Sanitize IP for filename (handle IPv6 colons)
    local SAFE_IP="${NODE_IP//:/_}"
    local NODE_LOG="$LOG_DIR/${SAFE_IP}_${USERNAME}.log"

    local ATTEMPT=1
    local STATUS="FAILED"
    local REASON="Unknown"

    {
        echo "=================================================="
        echo " CMM NODE PASSWORD RESET LOG"
        echo "=================================================="
        echo " Node IP   : $NODE_IP"
        echo " Node Type : $NODE_TYPE"
        echo " Username  : $USERNAME"
        echo " Time      : $(date '+%F %T')"
        echo "=================================================="
        echo ""
    } > "$NODE_LOG"

    while [ $ATTEMPT -le $MAX_RETRY ]; do
        echo "--- [Attempt $ATTEMPT of $MAX_RETRY] ---" >> "$NODE_LOG"

        # ---- FORMAT ROUTING ----
        # CMM_SHELL ? Format A (restricted '>' shell)
        # CMM_LINUX ? Format B (full bash + LDAP)
        # AUTO/blank ? Try A first, then B on failure
        local RESULT_CODE=0

        if [[ "$NODE_TYPE" == "CMM_SHELL" ]]; then
            echo "[Mode: CMM_SHELL � Format A]" >> "$NODE_LOG"
            run_format_a "$NODE_IP" "$USERNAME" "$OLD_PASS" "$NEW_PASS" "$NODE_LOG"
            RESULT_CODE=$?

        elif [[ "$NODE_TYPE" == "CMM_LINUX" ]]; then
            echo "[Mode: CMM_LINUX � Format B]" >> "$NODE_LOG"
            run_format_b "$NODE_IP" "$USERNAME" "$OLD_PASS" "$NEW_PASS" "$NODE_LOG"
            RESULT_CODE=$?

        else
            # AUTO-DETECT: Try Format A first
            echo "[Mode: AUTO � Trying Format A first]" >> "$NODE_LOG"
            run_format_a "$NODE_IP" "$USERNAME" "$OLD_PASS" "$NEW_PASS" "$NODE_LOG"
            RESULT_CODE=$?

            # If Format A fails with prompt/timeout issues, try Format B
            if [[ "$RESULT_CODE" -ne 0 && "$RESULT_CODE" -ne 13 && "$RESULT_CODE" -ne 22 ]]; then
                echo "" >> "$NODE_LOG"
                echo "[AUTO � Format A failed ($RESULT_CODE), retrying with Format B]" >> "$NODE_LOG"
                run_format_b "$NODE_IP" "$USERNAME" "$OLD_PASS" "$NEW_PASS" "$NODE_LOG"
                RESULT_CODE=$?
            fi
        fi

        echo "" >> "$NODE_LOG"
        echo "--- [Expect Exit Code: $RESULT_CODE] ---" >> "$NODE_LOG"

        local DECODED
        DECODED=$(decode_result "$RESULT_CODE")
        STATUS=$(echo "$DECODED" | cut -d'|' -f1)
        REASON=$(echo "$DECODED"  | cut -d'|' -f2)

        [[ "$STATUS" == "SUCCESS" ]] && break

        # Don't retry on auth/policy failures � they won't self-heal
        [[ "$RESULT_CODE" == "13" || "$RESULT_CODE" == "22" || "$RESULT_CODE" == "23" ]] && break

        ((ATTEMPT++))
        [[ $ATTEMPT -le $MAX_RETRY ]] && echo "Retrying in 5s..." >> "$NODE_LOG" && sleep 5
    done

    echo "" >> "$NODE_LOG"
    echo "=================================================="  >> "$NODE_LOG"
    echo " Final Status : $STATUS"                             >> "$NODE_LOG"
    echo " Reason       : $REASON"                            >> "$NODE_LOG"
    echo " Attempts     : $ATTEMPT"                           >> "$NODE_LOG"
    echo "=================================================="  >> "$NODE_LOG"

    # Thread-safe write to output CSV using a lock file
    (
        flock -w 10 200
        echo "\"$NODE_IP\",\"$NODE_TYPE\",\"$USERNAME\",\"$STATUS\",\"$REASON\",$ATTEMPT,\"$(date '+%F %T')\",\"$NODE_LOG\"" >> "$OUTPUT_CSV"
    ) 200>"$CSV_LOCK"

    printf "[%s] Node: %-40s | Type: %-10s | Status: %-8s | %s\n" \
        "$(date '+%T')" "$NODE_IP" "$NODE_TYPE" "$STATUS" "$REASON"
}

# ================================
# EXPORT & WORKER LOOP
# ================================
export -f process_node run_format_a run_format_b decode_result
export LOG_DIR OUTPUT_CSV CSV_LOCK TIMEOUT MAX_RETRY

while read -r LINE; do
    process_node "$LINE" &

    # Throttle parallelism
    while [[ $(jobs -r | wc -l) -ge $MAX_PARALLEL ]]; do
        wait -n 2>/dev/null || sleep 1
    done
done < "$PARSED_FILE"

# Wait for all background jobs to finish
wait
rm -f "$PARSED_FILE" "$CSV_LOCK"

echo "====================================================================="
echo ">>> Done! Results : $OUTPUT_CSV"
echo ">>> Full Logs     : $LOG_DIR"
exit 0