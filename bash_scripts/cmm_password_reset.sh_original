#!/bin/bash
# ==============================================================
# cmm_password_reset.sh (Django Integrated & Automated)
# ==============================================================
# Called by Django as:
#   bash cmm_password_reset.sh <input.csv> <output.csv>
#
# Input CSV Format:
#   NodeIP, NodeType, Username, OldPassword, NewPassword
# ==============================================================

INPUT_CSV="$1"
OUTPUT_CSV="$2"
MAX_RETRY=1
MAX_PARALLEL=3
TIMEOUT=30

if [[ -z "$INPUT_CSV" || -z "$OUTPUT_CSV" ]]; then
    echo "Usage: $0 <input.csv> <output.csv>" >&2
    exit 1
fi

if [[ ! -f "$INPUT_CSV" ]]; then
    echo "Error: Input file not found: $INPUT_CSV" >&2
    exit 1
fi

# ================================
# INITIALIZE DIRECTORIES & FILES
# ================================
OUTPUT_DIR="$(dirname "$OUTPUT_CSV")"
LOG_DIR="$OUTPUT_DIR/cmm_reset_logs_$(date +%Y%m%d_%H%M%S)"

mkdir -p "$OUTPUT_DIR"
mkdir -p "$LOG_DIR"

# Initialize CSV immediately
echo "NodeIP,NodeType,Username,Status,Reason,Attempts,Timestamp,LogFile" > "$OUTPUT_CSV"

# ================================
# PARSE INPUT CSV
# ================================
PARSED_FILE=$(mktemp)
DELIM=","
head -n 1 "$INPUT_CSV" | grep -qP '\t' && DELIM=$'\t'

# Read 5 columns: IP | TYPE | USER | OLD_PASS | NEW_PASS
tail -n +2 "$INPUT_CSV" | tr -d '\r' | while IFS="$DELIM" read -r IP TYPE USER OLD_PASS NEW_PASS _REST; do
    IP=$(echo "$IP" | xargs)
    [[ -z "$IP" ]] && continue
    echo "$IP|$TYPE|$USER|$OLD_PASS|$NEW_PASS" >> "$PARSED_FILE"
done

TOTAL_NODES=$(wc -l < "$PARSED_FILE")
echo ">>> Starting CMM Password Reset for $TOTAL_NODES nodes (Parallel: $MAX_PARALLEL)"
echo ">>> Detailed node logs will be saved to: $LOG_DIR"
echo "====================================================================="

# ================================
# CORE PASSWORD RESET FUNCTION
# ================================
process_node() {
    local LINE="$1"
    local NODE_IP=$(echo "$LINE" | cut -d'|' -f1)
    local NODE_TYPE=$(echo "$LINE" | cut -d'|' -f2)
    local USERNAME=$(echo "$LINE" | cut -d'|' -f3)
    local OLD_PASS=$(echo "$LINE" | cut -d'|' -f4)
    local NEW_PASS=$(echo "$LINE" | cut -d'|' -f5)

    local SAFE_IP="${NODE_IP//:/_}"
    local NODE_LOG="$LOG_DIR/${SAFE_IP}.log"

    local ATTEMPT=1
    local STATUS="FAILED"
    local REASON="Unknown"

    {
        echo "=================================================="
        echo " CMM NODE PASSWORD RESET LOG"
        echo "=================================================="
        echo " Node IP  : $NODE_IP"
        echo " Type     : $NODE_TYPE"
        echo " User     : $USERNAME"
        echo " Time     : $(date '+%F %T')"
        echo "=================================================="
        echo ""
    } > "$NODE_LOG"

    while [ $ATTEMPT -le $MAX_RETRY ]; do
        echo "--- [Attempt $ATTEMPT of $MAX_RETRY] ---" >> "$NODE_LOG"
        
        # Run Expect sequentially to handle CMM specific prompts
        expect <<EOF >> "$NODE_LOG" 2>&1
            set timeout $TIMEOUT
            spawn ssh -v -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 -o NumberOfPasswordPrompts=1 $USERNAME@$NODE_IP
            
            # --- STAGE 1: INITIAL LOGIN ---
            expect {
                -nocase "password:" { 
                    send "$OLD_PASS\r"
                    exp_continue 
                }
                -nocase "permission denied" { exit 13 }
                -nocase "authentication failed" { exit 13 }
                -nocase "connection refused" { exit 11 }
                -re {[\$>\#%]} { send "passwd\r" }
                timeout { exit 10 }
                eof { exit 17 }
            }

            # --- STAGE 2: PASSWD COMMAND EXECUTION ---
            expect {
                -re -nocase "password:" { send "$OLD_PASS\r" }
                timeout { exit 21 }
            }
            
            expect {
                -re -nocase "new.*password:" { send "$NEW_PASS\r" }
                -nocase "bad password" { exit 22 }
                timeout { exit 21 }
            }
            
            expect {
                -re -nocase "retype.*password:" { send "$NEW_PASS\r" }
                -re -nocase "re-enter.*password:" { send "$NEW_PASS\r" }
                -nocase "bad password" { exit 22 }
                timeout { exit 21 }
            }

            # --- STAGE 3: VERIFY RESULT ---
            expect {
                -nocase "successfully" { send "exit\r"; exit 0 }
                -nocase "bad password" { exit 22 }
                -nocase "token manipulation error" { exit 23 }
                -re {[\$>\#%]} { exit 24 }
                timeout { exit 21 }
            }
EOF
        
        RESULT_CODE=$?
        echo "" >> "$NODE_LOG"
        echo "--- [Expect Exit Code: $RESULT_CODE] ---" >> "$NODE_LOG"

        case "$RESULT_CODE" in
            0)  STATUS="SUCCESS"; REASON="Password Updated Successfully";;
            10) STATUS="FAILED";  REASON="SSH Timeout / No Route";;
            11) STATUS="FAILED";  REASON="Connection Refused";;
            13) STATUS="FAILED";  REASON="Wrong Old Password (Login Failed)";;
            17) STATUS="FAILED";  REASON="Connection Closed (EOF)";;
            21) STATUS="FAILED";  REASON="Passwd Prompt Timeout";;
            22) STATUS="FAILED";  REASON="BAD PASSWORD (Policy/Weak Password)";;
            23) STATUS="FAILED";  REASON="Token Manipulation Error";;
            24) STATUS="FAILED";  REASON="Unknown Failure (Shell returned without success msg)";;
            *)  STATUS="FAILED";  REASON="Unexpected Error ($RESULT_CODE)";;
        esac

        [[ "$STATUS" == "SUCCESS" ]] && break
        ((ATTEMPT++))
    done

    # Write final status to the node log
    echo "Final Status: $STATUS ($REASON)" >> "$NODE_LOG"

    # Write Result directly to the Output CSV
    echo "\"$NODE_IP\",\"$NODE_TYPE\",\"$USERNAME\",\"$STATUS\",\"$REASON\",$ATTEMPT,\"$(date '+%F %T')\",\"$NODE_LOG\"" >> "$OUTPUT_CSV"
    
    printf "[%s] Node: %-16s | Status: %-10s | Reason: %s\n" "$(date '+%T')" "$NODE_IP" "$STATUS" "$REASON"
}

# ================================
# WORKER LOOP
# ================================
export -f process_node

while read -r LINE; do
    process_node "$LINE" &
    
    if [[ $(jobs -r | wc -l) -ge $MAX_PARALLEL ]]; then
        wait -n
    fi
done < "$PARSED_FILE"

wait
rm -f "$PARSED_FILE"

echo "====================================================================="
echo ">>> Done! Results written to: $OUTPUT_CSV"
echo ">>> Full Execution Logs in:   $LOG_DIR"
exit 0
