#!/bin/bash
# ============================================================
# Script  : update_password.sh
# Purpose : Update node user passwords in remote DB servers.
#           Called by Django views.py (_run_script) as:
#             bash update_password.sh <input_csv> <output_csv>
#
# Args    : $1 = absolute path to input CSV
#           $2 = absolute path to output CSV (results)
#
# Input CSV format ($1):
#   node_ip,username,old_password,new_password
#
#   - node_ip     : real IP address  --> Mode A (update by ip+username)
#                   "NA"             --> Mode B (update by username+old_password)
#   - old_password: current password (plain or Base64)
#   - new_password: desired new password (plain or Base64)
#
# Output CSV ($2):
#   node_ip,username,db_server,db_name,password_format,status,remarks
#
# db_servers.csv format (same dir as script):
#   CHANGED: added db_type and port_number columns
#   server_ip,ssh_user,ssh_pass,db_user,db_pass,db_name,db_type,port_number
#
#   db_type values: mysql | mariadb | postgres | postgresql
#   port_number   : 3306 (mysql default) | 5432 (postgres default)
#   Both new columns are optional -- blank = mysql / 3306 (backward compat)
#
# DATABASE_TARGETS (configurable mapping):
#   db_name         -> table      -> ip_col   / user_col  / pass_col
#   inventory_prod_test -> node_master -> node_ip / node_user / password  [PostgreSQL]
#   GPAT_core       -> PAT_oss_node -> OSS_IP  / OSS_User  / OSS_Pwd   [MySQL]
#   GPAT_specific   -> PAT_oss_node -> OSS_IP  / OSS_User  / OSS_Pwd   [MySQL]
#   <any other>     -> node_info    -> ip       / username  / password  [MySQL legacy]
#
# CHANGES v1 (multi-DB + logging):
#   CHANGE-1:  db_servers.csv reading extended -- db_type + port_number
#   CHANGE-2:  get_db_config() expanded -- maps db_name to table/cols
#   CHANGE-3:  detect_db_format() -- accepts table/col params + pg path
#   CHANGE-4:  All 5 MySQL helpers -- accept table/col params (no hardcode)
#   CHANGE-5:  pg_detect_format() -- new PostgreSQL format detection
#   CHANGE-6:  pg_verify_mode_a() + pg_verify_mode_b() -- new PG verify
#   CHANGE-7:  main() MODE A loop -- dispatch mysql vs postgres
#   CHANGE-8:  main() MODE B loop -- dispatch mysql vs postgres
#   CHANGE-9:  normalise_ipv6() applied before SQL WHERE in both modes
#   CHANGE-10: LOG_DIR points to media/logs/ (uniform logging standard)
#
# CHANGES v3 (PostgreSQL SSH fix):
#   CHANGE-16: run_remote_psql() -- NEW: executes psql via SSH+Expect,
#              same architecture as run_remote_mysql(). PostgreSQL now:
#              script_server → SSH → db_server → psql localhost:port
#              Previously tried direct TCP connection which failed because
#              port 5432 is not exposed externally.
#   CHANGE-17: All pg_* functions rewritten to use run_remote_psql().
#              New param order: server_ip ssh_user ssh_pass added at front.
#   CHANGE-18: SSH pre-test now runs for PostgreSQL too (skip removed).
#   CHANGE-19: All pg_* call sites updated with ssh_user + ssh_pass args.
#   CHANGE-20: PostgreSQL Mode A uses group detection (all IPs, not first).
#
# CHANGES v2 (bug fixes):
#   CHANGE-11: detect_db_format_for_group() -- NEW: tries ALL IPs in group
#              not just first IP; fixes silent skip when first IP missing
#   CHANGE-12: MySQL Mode A detect call uses group function (CHANGE-11)
#   CHANGE-13: update_password_batch_mode_a() IN clause includes both
#              normalized and original IPv6 forms (dual-form fix)
#   CHANGE-14: verify_batch_mode_a() same dual-form IN clause + per-IP
#              logging to identify exactly which IP failed verification
#   CHANGE-15: Mode A result block: per-IP SUCCESS vs PARTIAL status
#              in output CSV instead of all-or-nothing
#
# All existing logic preserved. New code is additive only.
# ============================================================

NEW_PASSWORDS_CSV="${1:-}"
RESULT_CSV="${2:-}"

if [[ -z "$NEW_PASSWORDS_CSV" || -z "$RESULT_CSV" ]]; then
    echo "[ERROR] Usage: bash update_password.sh <input_csv> <output_csv>" >&2
    exit 1
fi

if [[ ! -f "$NEW_PASSWORDS_CSV" ]]; then
    echo "[ERROR] Input file not found: ${NEW_PASSWORDS_CSV}" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DB_SERVERS_CSV="${SCRIPT_DIR}/db_servers.csv"

# ─────────────────────────────────────────────────────────────
# CHANGE-2: get_db_config() — maps db_name + db_type to
#           table and column names.
#
# Outputs 5 lines (read with sed -n '1p' .. '5p'):
#   1: resolved_type  (mysql | postgres)
#   2: table_name
#   3: ip_column
#   4: user_column
#   5: password_column
#
# HOW TO ADD A NEW DB IN 2 MINUTES:
#   Add a new case block under the correct db_type (mysql/postgres).
#   Example — new MySQL DB "GPAT_new", table "nodes", cols "IP/User/Pass":
#
#     GPAT_new)
#         echo "mysql"
#         echo "nodes"
#         echo "IP"
#         echo "User"
#         echo "Pass"
#         ;;
#
#   Then add a row in db_servers.csv:
#     10.x.x.x,aceadm,pass,dbuser,dbpass,GPAT_new,mysql,3306
#   Done. No other changes needed.
# ─────────────────────────────────────────────────────────────
get_db_config() {
    local db_type="$1"
    local db_name="$2"

    # Normalise db_type to lowercase
    db_type="${db_type,,}"

    case "$db_type" in

        postgres|postgresql)
            # ── PostgreSQL targets ────────────────────────────
            case "$db_name" in
                inventory_prod_test|inventory_prod)
                    echo "postgres"
                    echo "node_master"
                    echo "node_ip"
                    echo "node_user"
                    echo "password"
                    ;;
                *)
                    # Generic postgres fallback (same schema as inventory_prod_test)
                    echo "postgres"
                    echo "node_master"
                    echo "node_ip"
                    echo "node_user"
                    echo "password"
                    ;;
            esac
            ;;

        mysql|mariadb|*)
            # ── MySQL / MariaDB targets ───────────────────────
            case "$db_name" in
                GPAT_core|GPAT_specific)
                    echo "mysql"
                    echo "PAT_oss_node"
                    echo "OSS_IP"
                    echo "OSS_User"
                    echo "OSS_Pwd"
                    ;;
		Inventory)
                    echo "mysql"
                    echo "OSS_DETAILS"
                    echo "oss_ip"
                    echo "oss_name"
                    echo "oss_password"
                    ;;
                *)
                    # Legacy default — existing node_info schema
                    # All existing db_servers.csv rows without db_type
                    # fall through here (backward compatible)
                    echo "mysql"
                    echo "node_info"
                    echo "ip"
                    echo "username"
                    echo "password"
                    ;;
            esac
            ;;

    esac
}

# CHANGE-10: Uniform log directory → media/logs/
# Derived relative to project root (2 levels above bash_scripts/)
MEDIA_LOGS_DIR="${SCRIPT_DIR}/../media/logs"
mkdir -p "${MEDIA_LOGS_DIR}" 2>/dev/null || true

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
#LOG_DIR="${MEDIA_LOGS_DIR}"

SCRIPT_NAME="$(basename "$0" .sh)"
if [[ -n "${JOB_LOG_DIR:-}" ]]; then
    LOG_DIR="$JOB_LOG_DIR"
else
    LOG_DIR="${MEDIA_LOGS_DIR}/${SCRIPT_NAME}_$(date +%Y%m%d_%H%M%S)"
fi
                           
LOG_FILE="${LOG_DIR}/password_update_${TIMESTAMP}.log"

mkdir -p "$(dirname "${RESULT_CSV}")"

if [ -t 2 ]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
    CYAN='\033[0;36m'; NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; CYAN=''; NC=''
fi

# ─────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────
# CHANGE-17: pg_update_remote
#
# FIXED: now SSHes into the DB server first, then runs psql
# against localhost — same pattern as run_remote_mysql().
# Added ssh_user ($2) and ssh_pass ($3) params.
#
# Args:
#   $1  server_ip  $2  ssh_user    $3  ssh_pass
#   $4  db_name    $5  db_user     $6  db_pass
#   $7  table      $8  ip_col      $9  user_col    $10 pass_col
#   $11 node_ip    $12 node_user   $13 new_pw      $14 old_pw
#   $15 mode(A|B)  $16 port (default 5432)
# ─────────────────────────────────────────────────────────────
pg_update_remote() {
    local server_ip="$1" ssh_user="$2"  ssh_pass="$3"
    local db_name="$4"   db_user="$5"   db_pass="$6"
    local table="$7"     ip_col="$8"    user_col="$9"    pass_col="${10}"
    local node_ip="${11}" node_user="${12}" new_pw="${13}" old_pw="${14}"
    local mode="${15}"   port="${16:-5432}"

    local escaped_new escaped_old
    escaped_new=$(python3 -c "import sys; print(sys.argv[1].replace(\"'\",\"''\"))" "$new_pw" 2>/dev/null || echo "$new_pw")
    escaped_old=$(python3 -c "import sys; print(sys.argv[1].replace(\"'\",\"''\"))" "$old_pw" 2>/dev/null || echo "$old_pw")

    local sql
    if [[ "$mode" == "A" ]]; then
        local norm_ip; norm_ip=$(normalise_ipv6 "$node_ip")
        sql="BEGIN; UPDATE \"${table}\" SET \"${pass_col}\"='${escaped_new}' WHERE \"${user_col}\"='${node_user}' AND \"${ip_col}\"='${norm_ip}'; COMMIT;"
    else
        sql="BEGIN; UPDATE \"${table}\" SET \"${pass_col}\"='${escaped_new}' WHERE \"${user_col}\"='${node_user}' AND \"${pass_col}\"='${escaped_old}'; COMMIT;"
    fi

    # CHANGE-17: SSH in, then run psql locally (not direct TCP to pg port)
    run_remote_psql "$server_ip" "$ssh_user" "$ssh_pass" \
                    "$db_user"   "$db_pass"  "$db_name" \
                    "$sql"       "$port"
    return $?
}

# ─────────────────────────────────────────────────────────────
# CHANGE-17: pg_verify_mode_a
# Verifies PostgreSQL Mode A update via SSH → psql localhost
# Added ssh_user ($2) and ssh_pass ($3) params.
# ─────────────────────────────────────────────────────────────
pg_verify_mode_a() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_name="$4"   db_user="$5"  db_pass="$6"
    local table="$7"     ip_col="$8"   user_col="$9"  pass_col="${10}"
    local node_user="${11}" new_pw="${12}" ip_list_str="${13}" port="${14:-5432}"

    local escaped_new
    escaped_new=$(python3 -c "import sys; print(sys.argv[1].replace(\"'\",\"''\"))" "$new_pw" 2>/dev/null || echo "$new_pw")

    local in_clause="" ip total_ips=0
    for ip in $ip_list_str; do
        local norm_ip; norm_ip=$(normalise_ipv6 "$ip")
        local esc_ip; esc_ip=$(python3 -c "import sys; print(sys.argv[1].replace(\"'\",\"''\"))" "$norm_ip" 2>/dev/null || echo "$norm_ip")
        in_clause="${in_clause:+${in_clause},}'${esc_ip}'"
        total_ips=$((total_ips + 1))
    done

    local sql="SELECT COUNT(*) FROM \"${table}\" WHERE \"${user_col}\"='${node_user}' AND \"${pass_col}\"='${escaped_new}' AND \"${ip_col}\" IN (${in_clause});"
    local out count
    out=$(run_remote_psql "$server_ip" "$ssh_user" "$ssh_pass" \
                          "$db_user"   "$db_pass"  "$db_name" \
                          "$sql"       "$port")
    count=$(echo "$out" | grep -v '^$' | head -1 | tr -d ' \r\n')
    echo "${count:-0}:${total_ips}"
    [[ "$count" =~ ^[0-9]+$ ]] && (( count == total_ips ))
}

# ─────────────────────────────────────────────────────────────
# CHANGE-17: pg_verify_mode_b
# Verifies PostgreSQL Mode B update via SSH → psql localhost
# Added ssh_user ($2) and ssh_pass ($3) params.
# ─────────────────────────────────────────────────────────────
pg_verify_mode_b() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_name="$4"   db_user="$5"  db_pass="$6"
    local table="$7"     user_col="$8" pass_col="$9"
    local node_user="${10}" new_pw="${11}" port="${12:-5432}"

    local escaped_new
    escaped_new=$(python3 -c "import sys; print(sys.argv[1].replace(\"'\",\"''\"))" "$new_pw" 2>/dev/null || echo "$new_pw")

    local sql="SELECT COUNT(*) FROM \"${table}\" WHERE \"${user_col}\"='${node_user}' AND \"${pass_col}\"='${escaped_new}';"
    local out count
    out=$(run_remote_psql "$server_ip" "$ssh_user" "$ssh_pass" \
                          "$db_user"   "$db_pass"  "$db_name" \
                          "$sql"       "$port")
    count=$(echo "$out" | grep -v '^$' | head -1 | tr -d ' \r\n')
    [[ "$count" =~ ^[0-9]+$ ]] && (( count > 0 ))
}

# ─────────────────────────────────────────────────────────────
# CHANGE-17: pg_check_rows_by_old_pw
# Pre-check for PG Mode B via SSH → psql localhost
# Added ssh_user ($2) and ssh_pass ($3) params.
# ─────────────────────────────────────────────────────────────
pg_check_rows_by_old_pw() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_name="$4"   db_user="$5"  db_pass="$6"
    local table="$7"     user_col="$8" pass_col="$9"
    local node_user="${10}" old_pw="${11}" port="${12:-5432}"

    local escaped_old
    escaped_old=$(python3 -c "import sys; print(sys.argv[1].replace(\"'\",\"''\"))" "$old_pw" 2>/dev/null || echo "$old_pw")

    local sql="SELECT COUNT(*) FROM \"${table}\" WHERE \"${user_col}\"='${node_user}' AND \"${pass_col}\"='${escaped_old}';"
    local out count
    out=$(run_remote_psql "$server_ip" "$ssh_user" "$ssh_pass" \
                          "$db_user"   "$db_pass"  "$db_name" \
                          "$sql"       "$port")
    count=$(echo "$out" | grep -v '^$' | head -1 | tr -d ' \r\n')
    echo "${count:-0}"
}

# ─────────────────────────────────────────────────────────────
# CHANGE-17: pg_detect_format
# FIXED: now SSHes in, then queries psql locally.
# Added ssh_user ($2) and ssh_pass ($3) params.
# Returns: "Base64" | "PlainText" | "NOT_FOUND" | "UNKNOWN"
# ─────────────────────────────────────────────────────────────
pg_detect_format() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_name="$4"   db_user="$5"  db_pass="$6"
    local table="$7"     ip_col="$8"   user_col="$9"  pass_col="${10}"
    local uname="${11}"  node_ip="${12}" port="${13:-5432}"

    local sql pg_out pg_rc sample

    if [[ -n "$node_ip" ]]; then
        local norm_ip; norm_ip=$(normalise_ipv6 "$node_ip")
        sql="SELECT \"${pass_col}\" FROM \"${table}\" WHERE \"${user_col}\"='${uname}' AND \"${ip_col}\"='${norm_ip}' LIMIT 1;"
    else
        sql="SELECT \"${pass_col}\" FROM \"${table}\" WHERE \"${user_col}\"='${uname}' LIMIT 1;"
    fi

    pg_out=$(run_remote_psql "$server_ip" "$ssh_user" "$ssh_pass" \
                              "$db_user"   "$db_pass"  "$db_name" \
                              "$sql"       "$port")
    pg_rc=$?

    log DEBUG "  [pg_detect] ${server_ip}/${db_name} rc=${pg_rc}"

    if [[ $pg_rc -ne 0 ]]; then
        local err_msg; err_msg=$(echo "$pg_out" | grep -v '^$' | head -2 | tr '\n' ' ')
        log WARN "  [pg_detect] psql via SSH failed (rc=${pg_rc}): ${err_msg}"
        echo "UNKNOWN"; return 1
    fi

    sample=$(echo "$pg_out" | grep -v '^$' | head -1 | tr -d ' \r\n')
    log DEBUG "  [pg_detect] sample='${sample}'"

    [[ -z "$sample" ]] && { echo "NOT_FOUND"; return 0; }
    if is_base64 "$sample"; then echo "Base64"; else echo "PlainText"; fi
    return 0
}

# ─────────────────────────────────────────────────────────────
# IPv6 normalisation (unchanged from previous version)
# ─────────────────────────────────────────────────────────────
normalise_ipv6() {
    local ip="$1"
    python3 - "$ip" <<'PYEOF' 2>/dev/null
import sys, ipaddress
try:
    print(str(ipaddress.ip_address(sys.argv[1])))
except Exception:
    print(sys.argv[1])
PYEOF
}

# -- Logger (unchanged) ----------------------------------------
log() {
    local level="$1"; shift
    local msg="$*"
    local ts; ts=$(date +"%Y-%m-%d %H:%M:%S")
    case "$level" in
        INFO)  echo -e "${CYAN}[${ts}] [INFO]  ${msg}${NC}" >&2 ;;
        OK)    echo -e "${GREEN}[${ts}] [OK]    ${msg}${NC}" >&2 ;;
        WARN)  echo -e "${YELLOW}[${ts}] [WARN]  ${msg}${NC}" >&2 ;;
        ERROR) echo -e "${RED}[${ts}] [ERROR] ${msg}${NC}" >&2 ;;
        DEBUG) echo    "[${ts}] [DEBUG] ${msg}" >&2 ;;
    esac
    echo "[${ts}] [${level}] ${msg}" >> "${LOG_FILE}"
    if [[ -n "${SRV_LOG_FILE:-}" ]]; then
        echo "[${ts}] [${level}] ${msg}" >> "${SRV_LOG_FILE}"
    fi
}

sanitize_ascii() { printf '%s' "$1" | tr -cd '[:print:]\t'; }

check_deps() {
    local missing=0
    for cmd in expect ssh mysql base64; do
        command -v "$cmd" &>/dev/null || { log ERROR "Missing command: $cmd"; missing=1; }
    done
    [[ $missing -eq 1 ]] && { log ERROR "Install missing deps and re-run."; exit 1; }
}

check_files() {
    if [[ ! -f "$DB_SERVERS_CSV" ]]; then
        log ERROR "DB servers config not found: ${DB_SERVERS_CSV}"
        exit 1
    fi
}

init_result_csv() {
    echo "node_ip,username,db_server,db_name,password_format,status,remarks" > "${RESULT_CSV}"
    log INFO "Result CSV : ${RESULT_CSV}"
}

append_result() {
    local remarks; remarks=$(sanitize_ascii "$7")
    echo "\"$1\",\"$2\",\"$3\",\"$4\",\"$5\",\"$6\",\"${remarks}\"" >> "${RESULT_CSV}"
}

is_valid_ip() {
    local ip="$1"
    if [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
        local a="${BASH_REMATCH[1]}" b="${BASH_REMATCH[2]}"
        local c="${BASH_REMATCH[3]}" d="${BASH_REMATCH[4]}"
        [[ $a -le 255 && $b -le 255 && $c -le 255 && $d -le 255 ]]
        return $?
    elif [[ "$ip" =~ ^[0-9a-fA-F:]+$ && "$ip" == *":"* ]]; then
        return 0
    else
        return 1
    fi
}

is_base64() {
    local val="$1"
    [[ -z "$val" ]] && return 1
    echo "$val" | grep -qE '^[A-Za-z0-9+/]+=*$' || return 1
    local len="${#val}"
    (( len % 4 != 0 )) && return 1
    local decoded
    decoded=$(echo "$val" | base64 -d 2>/dev/null)
    [[ $? -eq 0 && -n "$decoded" ]]
}

to_base64() { printf '%s' "$1" | base64 | tr -d '\n'; }

sql_escape() {
    local val="$1"
    val="${val//\\/\\\\}"
    val="${val//\'/\'\'}"
    printf '%s' "$val"
}

run_remote_mysql() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_user="$4"   db_pass="$5"  db_name="$6"
    local sql_query="$7"

    local uid="${$}_${RANDOM}_$(date +%s%N)"
    local remote_sql="/tmp/.ms_${uid}.sql"
    local sentinel_start="__START_${uid}__"
    local sentinel_end="__END_${uid}__"

    local b64_sql
    b64_sql=$(printf '%s' "$sql_query" | base64 | tr -d '\n')

    local cmd_write="echo ${b64_sql} | base64 -d > ${remote_sql}"
    local safe_db_pass; safe_db_pass=$(sql_escape "$db_pass")
    local ssh_cmd="${cmd_write} ; echo ${sentinel_start} ; mysql -u${db_user} -p'${safe_db_pass}' ${db_name} < ${remote_sql} 2>&1 ; echo ${sentinel_end}_\$? ; rm -f ${remote_sql}"

    export EXPECT_SSH_IP="$server_ip"
    export EXPECT_SSH_USER="$ssh_user"
    export EXPECT_SSH_PASS="$ssh_pass"
    export EXPECT_SSH_CMD="$ssh_cmd"

    local raw_output
    raw_output=$(
        expect -f - << 'EXPECT_SCRIPT'
log_user 0
set timeout 120
set ip   $env(EXPECT_SSH_IP)
set user $env(EXPECT_SSH_USER)
set pass $env(EXPECT_SSH_PASS)
set cmd  $env(EXPECT_SSH_CMD)
spawn ssh -T -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=15 -o ServerAliveInterval=10 "${user}@${ip}" "${cmd}"
expect {
    "yes/no"            { send "yes\r"; exp_continue }
    -nocase "password:" { send "${pass}\r"; exp_continue }
    eof                 { }
    timeout             { puts "EXPECT_ERR:ssh_or_mysql_timeout"; exit 1 }
}
puts "__OUTPUT_START__"
if {[info exists expect_out(buffer)]} { puts $expect_out(buffer) }
puts "__OUTPUT_END__"
EXPECT_SCRIPT
    )

    unset EXPECT_SSH_IP EXPECT_SSH_USER EXPECT_SSH_PASS EXPECT_SSH_CMD

    if echo "$raw_output" | grep -q "EXPECT_ERR:"; then
        local err; err=$(echo "$raw_output" | grep "EXPECT_ERR:" | head -1)
        log ERROR "Expect error on ${server_ip}: ${err}"
        return 1
    fi

    local mysql_rc
    mysql_rc=$(echo "$raw_output" | grep -oE "${sentinel_end}_[0-9]+" | awk -F'_' '{print $NF}' | tail -1)
    if [[ -z "$mysql_rc" ]]; then
        log DEBUG "  [run_remote_mysql] Missing sentinel. Raw: $(echo "$raw_output" | tr '\n' ' ')"
        return 1
    fi

    local sql_output
    sql_output=$(echo "$raw_output" \
        | sed -n "/${sentinel_start}/,/${sentinel_end}/p" \
        | grep -v "${sentinel_start}" | grep -v "${sentinel_end}" \
        | grep -v -i "warning.*password" | grep -v "^$" | tr -d '\r')

    echo "$sql_output"
    return "${mysql_rc:-0}"
}


# ─────────────────────────────────────────────────────────────
# CHANGE-16: run_remote_psql
#
# Executes a psql query via SSH — identical architecture to
# run_remote_mysql().  The script server SSHes into db_host,
# writes the SQL to a temp file, and runs psql against
# localhost on the remote machine.
#
# This is the correct approach because PostgreSQL (like MySQL)
# listens on localhost only; port 5432 is NOT exposed externally.
#
# Args:
#   $1 server_ip   $2 ssh_user  $3 ssh_pass
#   $4 db_user     $5 db_pass   $6 db_name
#   $7 sql_query   $8 port (default 5432)
#   $9 extra_flags (optional, e.g. "-t -A" for scalar output)
#
# Returns: psql stdout (stripped of headers/warnings)
# Exit code mirrors psql's exit code
# ─────────────────────────────────────────────────────────────
run_remote_psql() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_user="$4"   db_pass="$5"  db_name="$6"
    local sql_query="$7" port="${8:-5432}"
    local extra_flags="${9:--t -A}"   # default: tuples-only, unaligned

    local uid="${$}_${RANDOM}_$(date +%s%N)"
    local remote_sql="/tmp/.pg_${uid}.sql"
    local sentinel_start="__PGSTART_${uid}__"
    local sentinel_end="__PGEND_${uid}__"

    # Base64-encode SQL to survive SSH quoting (same trick as run_remote_mysql)
    local b64_sql
    b64_sql=$(printf '%s' "$sql_query" | base64 | tr -d '\n')

    # Escape db_pass for shell embedding (single-quote safe)
    local safe_db_pass; safe_db_pass=$(printf '%s' "$db_pass" | sed "s/'/'\\\\''/g")

    # Build remote command: decode SQL, run psql locally, clean up
    local ssh_cmd
    ssh_cmd="echo ${b64_sql} | base64 -d > ${remote_sql}"
    ssh_cmd="${ssh_cmd} ; echo ${sentinel_start}"
    ssh_cmd="${ssh_cmd} ; PGPASSWORD='${safe_db_pass}' psql -h localhost -p ${port} -U ${db_user} -d ${db_name} ${extra_flags} -f ${remote_sql} 2>&1"
    ssh_cmd="${ssh_cmd} ; echo ${sentinel_end}_\$?"
    ssh_cmd="${ssh_cmd} ; rm -f ${remote_sql}"

    export EXPECT_SSH_IP="$server_ip"
    export EXPECT_SSH_USER="$ssh_user"
    export EXPECT_SSH_PASS="$ssh_pass"
    export EXPECT_SSH_CMD="$ssh_cmd"

    local raw_output
    raw_output=$(
        expect -f - << 'EXPECT_SCRIPT'
log_user 0
set timeout 120
set ip   $env(EXPECT_SSH_IP)
set user $env(EXPECT_SSH_USER)
set pass $env(EXPECT_SSH_PASS)
set cmd  $env(EXPECT_SSH_CMD)
spawn ssh \
    -T \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=15 \
    -o ServerAliveInterval=10 \
    "${user}@${ip}" "${cmd}"
expect {
    "yes/no"            { send "yes\r"; exp_continue }
    -nocase "password:" { send "${pass}\r"; exp_continue }
    eof                 { }
    timeout             { puts "EXPECT_ERR:ssh_or_psql_timeout"; exit 1 }
}
puts "__OUTPUT_START__"
if {[info exists expect_out(buffer)]} { puts $expect_out(buffer) }
puts "__OUTPUT_END__"
EXPECT_SCRIPT
    )

    unset EXPECT_SSH_IP EXPECT_SSH_USER EXPECT_SSH_PASS EXPECT_SSH_CMD

    if echo "$raw_output" | grep -q "EXPECT_ERR:"; then
        local err; err=$(echo "$raw_output" | grep "EXPECT_ERR:" | head -1)
        log ERROR "  [run_remote_psql] Expect error on ${server_ip}: ${err}"
        return 1
    fi

    local psql_rc
    psql_rc=$(echo "$raw_output" | grep -oE "${sentinel_end}_[0-9]+" \
              | awk -F'_' '{print $NF}' | tail -1)

    if [[ -z "$psql_rc" ]]; then
        log DEBUG "  [run_remote_psql] Missing sentinel — raw: $(echo "$raw_output" | tr '\n' ' ' | cut -c1-200)"
        return 1
    fi

    # Extract output between sentinels; strip psql noise
    local sql_output
    sql_output=$(echo "$raw_output" \
        | sed -n "/${sentinel_start}/,/${sentinel_end}/p" \
        | grep -v "${sentinel_start}" \
        | grep -v "${sentinel_end}" \
        | grep -v -i "warning" \
        | grep -v "^$" \
        | tr -d '\r')

    echo "$sql_output"
    return "${psql_rc:-0}"
}

test_ssh() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local result
    result=$(
        expect -f - << EEXP 2>/dev/null
log_user 0
set timeout 20
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=10 "${ssh_user}@${server_ip}" "echo __SSHOK__"
expect {
    "yes/no"            { send "yes\r"; exp_continue }
    -nocase "password:" { send "${ssh_pass}\r"; exp_continue }
    "__SSHOK__"         { puts "__SSHOK__" }
    timeout             { exit 1 }
    eof                 { }
}
expect eof
EEXP
    )
    echo "$result" | grep -q "__SSHOK__"
}

# ─────────────────────────────────────────────────────────────
# CHANGE-3: detect_db_format — added table/col params.
# Now accepts: table ip_col user_col pass_col as args 9-12.
# Defaults to legacy node_info/ip/username/password for
# backward compatibility when called without new params.
# ─────────────────────────────────────────────────────────────
detect_db_format() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_user="$4"   db_pass="$5"  db_name="$6"
    local uname="$7"     node_ip="$8"
    # CHANGED: new params with backward-compat defaults
    local table="${9:-node_info}"
    local ip_col="${10:-ip}"
    local user_col="${11:-username}"
    local pass_col="${12:-password}"

    local sql out rc sample
    local safe_uname; safe_uname=$(sql_escape "$uname")

    if [[ -n "$node_ip" ]]; then
        # CHANGE-9: normalise IPv6 before SQL
        local norm_ip; norm_ip=$(normalise_ipv6 "$node_ip")
        local safe_ip; safe_ip=$(sql_escape "$norm_ip")
        # CHANGED: use dynamic table/col names
        sql="SELECT \`${pass_col}\` FROM \`${table}\` WHERE \`${ip_col}\`='${safe_ip}' AND \`${user_col}\`='${safe_uname}' LIMIT 1;"
        out=$(run_remote_mysql "$server_ip" "$ssh_user" "$ssh_pass" \
                               "$db_user"   "$db_pass"  "$db_name" "$sql")
        rc=$?
        sample=$(echo "$out" | grep -v -i "^${pass_col}$" | grep -v -i 'warning' \
            | grep -v '^$' | head -1 | tr -d '\r\n')
        sample=$(sanitize_ascii "$sample")
        log DEBUG "  [detect_format] ip+uname query rc=${rc} sample='${sample}'"

        if [[ $rc -eq 0 && -z "$sample" ]]; then
            echo "NOT_FOUND"; return 0
        fi
    fi

    if [[ -z "$sample" ]]; then
        # CHANGED: use dynamic table/col names
        sql="SELECT \`${pass_col}\` FROM \`${table}\` WHERE \`${user_col}\`='${safe_uname}' LIMIT 1;"
        out=$(run_remote_mysql "$server_ip" "$ssh_user" "$ssh_pass" \
                               "$db_user"   "$db_pass"  "$db_name" "$sql")
        rc=$?
        sample=$(echo "$out" | grep -v -i "^${pass_col}$" | grep -v -i 'warning' \
            | grep -v '^$' | head -1 | tr -d '\r\n')
        sample=$(sanitize_ascii "$sample")
        log DEBUG "  [detect_format] uname-only fallback rc=${rc} sample='${sample}'"
    fi

    if [[ $rc -ne 0 ]]; then echo "UNKNOWN"; return 1; fi
    if [[ -z "$sample" ]]; then echo "NOT_FOUND"; return 0; fi
    if is_base64 "$sample"; then echo "Base64"; else echo "PlainText"; fi
    return 0
}

# ─────────────────────────────────────────────────────────────
# detect_db_format_for_group (IMPROVED - batch IN query)
#
# Sends ONE batch SELECT with IN (...) covering ALL node IPs at once
# instead of looping and issuing one query per IP.
# Single query checks ALL IPs simultaneously -- much faster for large groups.
#
# SQL pattern:
#   SELECT `pass_col` FROM `table`
#   WHERE `user_col`='uname'
#   AND (`ip_col` IN (ip1,ip2,...) OR INET6_NTOA(INET6_ATON(`ip_col`)) IN (...))
#   LIMIT 1;
#
# Args:
#   $1-$6 : server_ip ssh_user ssh_pass db_user db_pass db_name
#   $7    : uname
#   $8    : space-separated ip_list (the full group)
#   $9-12 : table ip_col user_col pass_col (optional, with defaults)
#
# Returns via echo: "Base64" | "PlainText" | "NOT_FOUND" | "UNKNOWN"
detect_db_format_for_group() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_user="$4"   db_pass="$5"  db_name="$6"
    local uname="$7"     ip_list_str="$8"
    local table="${9:-node_info}"
    local ip_col="${10:-ip}"
    local user_col="${11:-username}"
    local pass_col="${12:-password}"

    local safe_uname; safe_uname=$(sql_escape "$uname")

    # Build IN (...) list covering all IPs (original + normalised IPv6)
    local in_list="" count=0
    for try_ip in $ip_list_str; do
        local norm_ip; norm_ip=$(normalise_ipv6 "$try_ip")
        local safe_ip; safe_ip=$(sql_escape "$norm_ip")
        local safe_orig; safe_orig=$(sql_escape "$try_ip")
        if [[ -n "$in_list" ]]; then
            in_list="${in_list},'${safe_ip}','${safe_orig}'"
        else
            in_list="'${safe_ip}','${safe_orig}'"
        fi
        count=$((count + 1))
    done

    if [[ $count -eq 0 ]]; then
        log WARN "  [detect_group] empty ip_list -- NOT_FOUND"
        echo "NOT_FOUND"; return 0
    fi

    log DEBUG "  [detect_group] Batch IN query for ${count} IP(s) user=${uname} on ${db_name}"

    # ONE query checks ALL IPs at once -- no loop
    local sql="SELECT \`${pass_col}\` FROM \`${table}\` WHERE \`${user_col}\`='${safe_uname}' AND (\`${ip_col}\` IN (${in_list}) OR INET6_NTOA(INET6_ATON(\`${ip_col}\`)) IN (${in_list})) LIMIT 1;"

    local out rc sample
    out=$(run_remote_mysql "$server_ip" "$ssh_user" "$ssh_pass" \
                           "$db_user"   "$db_pass"  "$db_name" "$sql")
    rc=$?
    sample=$(echo "$out" | grep -v -i "^${pass_col}$" | grep -v -i 'warning' \
        | grep -v '^$' | head -1 | tr -d '\r\n')
    sample=$(sanitize_ascii "$sample")
    log DEBUG "  [detect_group] batch rc=${rc} sample_len=${#sample}"

    if [[ $rc -ne 0 ]]; then
        log ERROR "  [detect_group] batch query FAILED (rc=${rc}) -- UNKNOWN"
        echo "UNKNOWN"; return 1
    fi
    if [[ -z "$sample" ]]; then
        log DEBUG "  [detect_group] no rows found for any of ${count} IP(s) -- NOT_FOUND"
        echo "NOT_FOUND"; return 0
    fi
    if is_base64 "$sample"; then echo "Base64"; else echo "PlainText"; fi
    return 0
}

resolve_passwords() {
    local fmt="$1" user_old_pw="$2" user_new_pw="$3"
    local db_new db_old
    if [[ "$fmt" == "Base64" ]]; then
        db_new=$(to_base64 "$user_new_pw")
        db_old=$(to_base64 "$user_old_pw")
        log DEBUG "  [resolve_pw] Base64 -> new='${db_new}'  old='${db_old}'"
    else
        db_new="$user_new_pw"
        db_old="$user_old_pw"
        log DEBUG "  [resolve_pw] PlainText -> new='${db_new}'  old='${db_old}'"
    fi
    echo "$db_new"
    echo "$db_old"
}

# ─────────────────────────────────────────────────────────────
# CHANGE-4: All MySQL helpers now accept table/col params.
# New params added at the end of each function signature with
# backward-compat defaults so any existing direct calls still work.
# ─────────────────────────────────────────────────────────────

update_password_batch_mode_a() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_user="$4"   db_pass="$5"  db_name="$6"
    local uname="$7"     new_pw="$8"   ip_list_str="$9"
    # CHANGED: new params
    local table="${10:-node_info}"
    local ip_col="${11:-ip}"
    local user_col="${12:-username}"
    local pass_col="${13:-password}"

    local safe_uname; safe_uname=$(sql_escape "$uname")
    local safe_pw;    safe_pw=$(sql_escape "$new_pw")

    # CHANGE-13: include BOTH normalized and original IPv6 in IN clause.
    # Handles DBs storing expanded IPv6 when CSV has compressed (or vice versa).
    # For IPv4 normalise_ipv6() is a no-op so no impact on existing behaviour.
    local in_clause=""
    for ip in $ip_list_str; do
        local norm_ip; norm_ip=$(normalise_ipv6 "$ip")
        local safe_norm; safe_norm=$(sql_escape "$norm_ip")
        in_clause="${in_clause:+${in_clause},}'${safe_norm}'"
        # Add original form too if it differs (catches un-normalised DB storage)
        if [[ "$norm_ip" != "$ip" ]]; then
            local safe_orig; safe_orig=$(sql_escape "$ip")
            in_clause="${in_clause},'${safe_orig}'"
            log DEBUG "  [batch_update] IPv6 dual-form: norm='${norm_ip}' orig='${ip}'"
        fi
    done

    # CHANGED: dynamic table/col names
    local sql="UPDATE \`${table}\` SET \`${pass_col}\`='${safe_pw}' WHERE \`${user_col}\`='${safe_uname}' AND \`${ip_col}\` IN (${in_clause});"
    log DEBUG "  [MODE A] UPDATE SQL (table=${table}): ${sql}"

    run_remote_mysql "$server_ip" "$ssh_user" "$ssh_pass" \
                     "$db_user"   "$db_pass"  "$db_name"  "$sql" \
                     >> "${SRV_LOG_FILE:-${LOG_FILE}}" 2>&1
    return $?
}

verify_batch_mode_a() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_user="$4"   db_pass="$5"  db_name="$6"
    local uname="$7"     expected="$8" ip_list_str="$9"
    # CHANGED: new params
    local table="${10:-node_info}"
    local ip_col="${11:-ip}"
    local user_col="${12:-username}"
    local pass_col="${13:-password}"

    local safe_uname; safe_uname=$(sql_escape "$uname")
    local safe_exp;   safe_exp=$(sql_escape "$expected")

    # CHANGE-14A: dual-form IPv6 in verify IN clause (mirrors CHANGE-13)
    local in_clause="" total_ips=0
    for ip in $ip_list_str; do
        local norm_ip; norm_ip=$(normalise_ipv6 "$ip")
        local safe_norm; safe_norm=$(sql_escape "$norm_ip")
        in_clause="${in_clause:+${in_clause},}'${safe_norm}'"
        if [[ "$norm_ip" != "$ip" ]]; then
            local safe_orig; safe_orig=$(sql_escape "$ip")
            in_clause="${in_clause},'${safe_orig}'"
        fi
        total_ips=$((total_ips + 1))
    done

    local sql="SELECT COUNT(*) FROM \`${table}\` WHERE \`${user_col}\`='${safe_uname}' AND \`${pass_col}\`='${safe_exp}' AND \`${ip_col}\` IN (${in_clause});"
    local out count
    out=$(run_remote_mysql "$server_ip" "$ssh_user" "$ssh_pass" \
                           "$db_user"   "$db_pass"  "$db_name"  "$sql")
    count=$(echo "$out" | grep -v -i '^count' | grep -v -i 'warning' \
        | grep -v '^$' | head -1 | tr -d '\r\n ')
    log DEBUG "  [MODE A] verify: expected=${total_ips} verified=${count:-0}"
    echo "${count:-0}:${total_ips}"

    # CHANGE-14B: when partial, query per-IP to log exactly which one failed
    if [[ "$count" =~ ^[0-9]+$ ]] && (( count < total_ips )); then
        log WARN "  [VERIFY] Partial update -- identifying missing IPs ..."
        local found_ips_sql
        found_ips_sql="SELECT \`${ip_col}\` FROM \`${table}\` WHERE \`${user_col}\`='${safe_uname}' AND \`${pass_col}\`='${safe_exp}' AND \`${ip_col}\` IN (${in_clause});"
        local found_out
        found_out=$(run_remote_mysql "$server_ip" "$ssh_user" "$ssh_pass" \
                                     "$db_user"   "$db_pass"  "$db_name" \
                                     "$found_ips_sql" 2>/dev/null)
        for chk_ip in $ip_list_str; do
            local norm_chk; norm_chk=$(normalise_ipv6 "$chk_ip")
            if echo "$found_out" | grep -qF "$norm_chk" || echo "$found_out" | grep -qF "$chk_ip"; then
                log OK   "  [VERIFY] ✓ ${chk_ip} -- updated successfully"
            else
                log WARN "  [VERIFY] ✗ ${chk_ip} -- NOT updated (not found with new password)"
            fi
        done
    fi

    [[ "$count" =~ ^[0-9]+$ ]] && (( count == total_ips ))
}

update_password_by_old_pw() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_user="$4"   db_pass="$5"  db_name="$6"
    local uname="$7"     new_pw="$8"   old_pw="$9"
    # CHANGED: new params
    local table="${10:-node_info}"
    local user_col="${11:-username}"
    local pass_col="${12:-password}"

    local safe_uname; safe_uname=$(sql_escape "$uname")
    local safe_new;   safe_new=$(sql_escape "$new_pw")
    local safe_old;   safe_old=$(sql_escape "$old_pw")

    # CHANGED: dynamic table/col names
    local sql="UPDATE \`${table}\` SET \`${pass_col}\`='${safe_new}' WHERE \`${user_col}\`='${safe_uname}' AND \`${pass_col}\`='${safe_old}';"

    run_remote_mysql "$server_ip" "$ssh_user" "$ssh_pass" \
                     "$db_user"   "$db_pass"  "$db_name"  "$sql" \
                     >> "${SRV_LOG_FILE:-${LOG_FILE}}" 2>&1
    return $?
}

verify_password_by_uname() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_user="$4"   db_pass="$5"  db_name="$6"
    local uname="$7"     expected="$8"
    # CHANGED: new params
    local table="${9:-node_info}"
    local user_col="${10:-username}"
    local pass_col="${11:-password}"

    local safe_uname; safe_uname=$(sql_escape "$uname")
    local safe_exp;   safe_exp=$(sql_escape "$expected")

    # CHANGED: dynamic table/col names
    local sql="SELECT COUNT(*) FROM \`${table}\` WHERE \`${user_col}\`='${safe_uname}' AND \`${pass_col}\`='${safe_exp}';"
    local out count
    out=$(run_remote_mysql "$server_ip" "$ssh_user" "$ssh_pass" \
                           "$db_user"   "$db_pass"  "$db_name"  "$sql")
    count=$(echo "$out" | grep -v -i '^count' | grep -v -i 'warning' \
        | grep -v '^$' | head -1 | tr -d '\r\n ')
    log DEBUG "  [MODE B] verify: rows with new password for '${uname}': ${count}"
    [[ "$count" =~ ^[0-9]+$ ]] && (( count > 0 ))
}

check_rows_affected_by_old_pw() {
    local server_ip="$1" ssh_user="$2" ssh_pass="$3"
    local db_user="$4"   db_pass="$5"  db_name="$6"
    local uname="$7"     old_pw="$8"
    # CHANGED: new params
    local table="${9:-node_info}"
    local user_col="${10:-username}"
    local pass_col="${11:-password}"

    local safe_uname; safe_uname=$(sql_escape "$uname")
    local safe_old;   safe_old=$(sql_escape "$old_pw")

    # CHANGED: dynamic table/col names
    local sql="SELECT COUNT(*) FROM \`${table}\` WHERE \`${user_col}\`='${safe_uname}' AND \`${pass_col}\`='${safe_old}';"
    local out count
    out=$(run_remote_mysql "$server_ip" "$ssh_user" "$ssh_pass" \
                           "$db_user"   "$db_pass"  "$db_name"  "$sql")
    count=$(echo "$out" | grep -v -i '^count' | grep -v -i 'warning' \
        | grep -v '^$' | head -1 | tr -d '\r\n ')
    echo "${count:-0}"
}

# ==============================================================
# MAIN
# ==============================================================
main() {
    log INFO "========================================================"
    log INFO " Node Password Update in DB -- Started"
    log INFO " Timestamp   : ${TIMESTAMP}"
    log INFO " Input CSV   : ${NEW_PASSWORDS_CSV}"
    log INFO " Output CSV  : ${RESULT_CSV}"
    log INFO " Main Log    : ${LOG_FILE}"
    log INFO " DB Servers  : ${DB_SERVERS_CSV}"
    log INFO "========================================================"

    check_deps
    check_files
    init_result_csv

    # ──────────────────────────────────────────────────────────
    # CHANGE-1: Load DB servers — read db_type and port_number
    # Old format: server_ip,ssh_user,ssh_pass,db_user,db_pass,db_name
    # New format: server_ip,ssh_user,ssh_pass,db_user,db_pass,db_name,db_type,port_number
    # Backward compat: missing db_type → "mysql", missing port → "3306"
    # ──────────────────────────────────────────────────────────
    declare -a SRV_IP SRV_SSH_U SRV_SSH_P SRV_DB_U SRV_DB_P SRV_DB_N
    declare -a SRV_DB_TYPE SRV_DB_PORT          # CHANGED: new arrays
    declare -A SSH_UP SRV_LOG
    local n=0

    while IFS=',' read -r sip su sp du dp dn db_type port_number; do
        sip=$(echo "$sip"         | tr -d '\r ')
        [[ "$sip" == "server_ip" || -z "$sip" ]] && continue
        SRV_IP[$n]="$sip"
        SRV_SSH_U[$n]=$(echo "$su"  | tr -d '\r ')
        SRV_SSH_P[$n]=$(echo "$sp"  | tr -d '\r ')
        SRV_DB_U[$n]=$(echo "$du"   | tr -d '\r ')
        SRV_DB_P[$n]=$(echo "$dp"   | tr -d '\r ')
        SRV_DB_N[$n]=$(echo "$dn"   | tr -d '\r ')
        # CHANGED: read and default new columns
        local _dt; _dt=$(echo "$db_type"     | tr -d '\r ' | tr '[:upper:]' '[:lower:]')
        local _pn; _pn=$(echo "$port_number" | tr -d '\r ')
        SRV_DB_TYPE[$n]="${_dt:-mysql}"
        SRV_DB_PORT[$n]="${_pn:-3306}"
        SRV_LOG[$n]="${LOG_DIR}/password_update_${TIMESTAMP}_srv_${sip}.log"
        n=$((n + 1))
    done < "$DB_SERVERS_CSV"

    if [[ $n -eq 0 ]]; then
        log ERROR "No DB servers loaded from ${DB_SERVERS_CSV} -- aborting."; exit 1
    fi
    log INFO "Loaded ${n} DB server(s)"

    log INFO "Testing SSH connectivity ..."
    for i in "${!SRV_IP[@]}"; do
        SRV_LOG_FILE="${SRV_LOG[$i]}"
        # CHANGE-18: PostgreSQL now uses SSH (same as MySQL) -- skip removed
        if test_ssh "${SRV_IP[$i]}" "${SRV_SSH_U[$i]}" "${SRV_SSH_P[$i]}"; then
            log OK   "  SSH OK  - ${SRV_IP[$i]}"
            SSH_UP[$i]=1
        else
            log WARN "  SSH FAIL - ${SRV_IP[$i]}"
            SSH_UP[$i]=0
        fi
        SRV_LOG_FILE=""
    done

    # -- Parse input CSV (unchanged) ---------------------------
    declare -A MODE_A_GROUPS MODE_A_DATA
    declare -a MODE_B_ROWS ROW_ORDER_A

    while IFS=',' read -r node_ip uname old_pw new_pw; do
        node_ip=$(echo "$node_ip" | tr -d '\r' | xargs)
        uname=$(echo "$uname"     | tr -d '\r' | xargs)
        old_pw=$(echo "$old_pw"   | tr -d '\r' | xargs)
        new_pw=$(echo "$new_pw"   | tr -d '\r' | xargs)
        [[ "$node_ip" == "node_ip" || -z "$node_ip" ]] && continue
        [[ -z "$uname" ]] && continue
        if [[ "${node_ip^^}" == "NA" ]]; then
            [[ -z "$old_pw" ]] && { log WARN "  Skipping Mode B: username='${uname}' -- old_pw empty"; continue; }
            MODE_B_ROWS+=("${uname}|${old_pw}|${new_pw}")
        else
            if ! is_valid_ip "$node_ip"; then
                log WARN "  Skipping invalid IP: '${node_ip}' (username=${uname})"; continue
            fi
            if [[ -z "${MODE_A_GROUPS[$uname]+x}" ]]; then
                MODE_A_GROUPS[$uname]="$node_ip"
                MODE_A_DATA[$uname]="${old_pw}|${new_pw}"
                ROW_ORDER_A+=("$uname")
            else
                echo "${MODE_A_GROUPS[$uname]}" | grep -qw "$node_ip" || \
                    MODE_A_GROUPS[$uname]="${MODE_A_GROUPS[$uname]} ${node_ip}"
            fi
        fi
    done < "$NEW_PASSWORDS_CSV"

    log INFO "Mode A groups: ${#ROW_ORDER_A[@]}"
    log INFO "Mode B rows  : ${#MODE_B_ROWS[@]}"

    local total=0 success=0 failed=0 skipped=0

    # ===========================================================
    # PROCESS MODE A
    # ===========================================================
    local seen_a=()
    for uname in "${ROW_ORDER_A[@]}"; do
        local already=0
        for s in "${seen_a[@]:-}"; do [[ "$s" == "$uname" ]] && { already=1; break; }; done
        [[ $already -eq 1 ]] && continue
        seen_a+=("$uname")

        local ip_list="${MODE_A_GROUPS[$uname]}"
        local user_old_pw user_new_pw
        IFS='|' read -r user_old_pw user_new_pw <<< "${MODE_A_DATA[$uname]}"
        local ip_count; ip_count=$(echo "$ip_list" | wc -w | tr -d ' ')
        total=$((total + 1))

        log INFO "============================================================"
        log INFO "[MODE A] username='${uname}'  IPs=${ip_count}  [${ip_list}]"

        for i in "${!SRV_IP[@]}"; do
            local db_s="${SRV_IP[$i]}"
            local ssh_u="${SRV_SSH_U[$i]}"  ssh_p="${SRV_SSH_P[$i]}"
            local db_u="${SRV_DB_U[$i]}"    db_p="${SRV_DB_P[$i]}"
            local db_n="${SRV_DB_N[$i]}"
            # CHANGED: read db_type and port
            local cur_db_type="${SRV_DB_TYPE[$i]:-mysql}"
            local cur_db_port="${SRV_DB_PORT[$i]:-3306}"
            SRV_LOG_FILE="${SRV_LOG[$i]}"

            # CHANGE-2: resolve table/col config for this DB server
            local cfg db_type_resolved db_table db_ip_col db_user_col db_pass_col
            cfg=$(get_db_config "$cur_db_type" "$db_n")
            db_type_resolved=$(echo "$cfg" | sed -n '1p')
            db_table=$(echo "$cfg"         | sed -n '2p')
            db_ip_col=$(echo "$cfg"        | sed -n '3p')
            db_user_col=$(echo "$cfg"      | sed -n '4p')
            db_pass_col=$(echo "$cfg"      | sed -n '5p')

            log INFO "  DB Server: ${db_s}  |  DB: ${db_n}  |  Type: ${db_type_resolved}  |  Table: ${db_table}"
            log INFO "  Columns: ip=${db_ip_col} user=${db_user_col} pass=${db_pass_col}"

            if [[ "${SSH_UP[$i]}" == "0" ]]; then
                log WARN "  Skipping -- SSH unavailable for ${db_s}"
                for ip in $ip_list; do
                    append_result "$ip" "$uname" "$db_s" "$db_n" "UNKNOWN" "SKIPPED" "SSH to DB server failed"
                    skipped=$((skipped + 1))
                done
                SRV_LOG_FILE=""; continue
            fi

            # ── dispatch mysql vs postgres ────────────────────
            if [[ "$db_type_resolved" == "postgres" ]]; then
                # ── PostgreSQL MODE A ─────────────────────────
                # CHANGE-19+20: SSH credentials passed; all IPs tried (not just first)
                local ip_count_pg; ip_count_pg=$(echo "$ip_list" | wc -w | tr -d ' ')
                log INFO "  [PostgreSQL] Detecting format (SSH → psql, checking all ${ip_count_pg} IPs) ..."

                local fmt="NOT_FOUND"
                for try_pg_ip in $ip_list; do
                    local try_fmt
                    try_fmt=$(pg_detect_format "$db_s" "$ssh_u" "$ssh_p" \
                                               "$db_n"  "$db_u"  "$db_p" \
                                               "$db_table" "$db_ip_col" "$db_user_col" "$db_pass_col" \
                                               "$uname" "$try_pg_ip" "$cur_db_port")
                    log DEBUG "  [PG detect_group] ${try_pg_ip} → ${try_fmt}"
                    case "$try_fmt" in
                        NOT_FOUND) continue ;;
                        UNKNOWN)   fmt="UNKNOWN"; break ;;
                        Base64|PlainText) fmt="$try_fmt"; break ;;
                    esac
                done
                log INFO "  Detected format: ${fmt}"

                if [[ "$fmt" == "NOT_FOUND" ]]; then
                    log WARN "  username/ip not found on ${db_s} (checked all ${ip_count_pg} IPs) -- skipping"
                    for ip in $ip_list; do
                        append_result "$ip" "$uname" "$db_s" "$db_n" "UNKNOWN" "SKIPPED" "not found in ${db_table} (all IPs tried)"
                        skipped=$((skipped + 1))
                    done
                    SRV_LOG_FILE=""; continue
                fi

                if [[ "$fmt" == "UNKNOWN" ]]; then
                    log ERROR "  Format detection failed on ${db_s}"
                    for ip in $ip_list; do
                        append_result "$ip" "$uname" "$db_s" "$db_n" "UNKNOWN" "FAILED" "PG format detection failed (SSH/psql error)"
                        failed=$((failed + 1))
                    done
                    SRV_LOG_FILE=""; continue
                fi

                local resolved db_new_pw db_old_pw
                resolved=$(resolve_passwords "$fmt" "$user_old_pw" "$user_new_pw")
                db_new_pw=$(echo "$resolved" | sed -n '1p')

                # One UPDATE per IP via SSH → psql
                local pg_success=0 pg_fail=0
                for ip in $ip_list; do
                    local norm_ip; norm_ip=$(normalise_ipv6 "$ip")
                    local pg_out
                    # CHANGE-19: pass ssh_u ssh_p before db credentials
                    pg_out=$(pg_update_remote "$db_s" "$ssh_u" "$ssh_p" \
                                              "$db_n"  "$db_u"  "$db_p" \
                                              "$db_table" "$db_ip_col" "$db_user_col" "$db_pass_col" \
                                              "$norm_ip" "$uname" "$db_new_pw" "" "A" "$cur_db_port" 2>&1)
                    local pg_rc=$?

                    if echo "$pg_out" | grep -qiE "UPDATE [1-9]"; then
                        log OK "  [PG MODE A] ✓ ${ip} / ${uname} on ${db_s}/${db_n}"
                        append_result "$ip" "$uname" "$db_s" "$db_n" "$fmt" "SUCCESS" "PG MODE A: updated"
                        pg_success=$((pg_success + 1))
                        success=$((success + 1))
                    elif echo "$pg_out" | grep -qiE "UPDATE 0"; then
                        log WARN "  [PG MODE A] 0 rows: ${ip} / ${uname}"
                        append_result "$ip" "$uname" "$db_s" "$db_n" "$fmt" "SKIPPED" "PG MODE A: 0 rows updated"
                        skipped=$((skipped + 1))
                    else
                        log ERROR "  [PG MODE A] FAILED ${ip}: $(echo "$pg_out" | tail -1)"
                        append_result "$ip" "$uname" "$db_s" "$db_n" "$fmt" "FAILED" \
                                      "PG MODE A: $(sanitize_ascii "$(echo "$pg_out" | tail -1)")"
                        pg_fail=$((pg_fail + 1))
                        failed=$((failed + 1))
                    fi
                done
                log INFO "  [PG MODE A] done: ok=${pg_success} fail=${pg_fail}"
                SRV_LOG_FILE=""; continue
            fi

            # ── MySQL / MariaDB MODE A ────────────────────────
            # CHANGE-12: use detect_db_format_for_group (tries ALL IPs)
            local ip_count_grp; ip_count_grp=$(echo "$ip_list" | wc -w | tr -d ' ')
            log INFO "  Detecting DB storage format (checking all ${ip_count_grp} IPs) ..."
            local fmt
            fmt=$(detect_db_format_for_group "$db_s" "$ssh_u" "$ssh_p" "$db_u" "$db_p" "$db_n" \
                                              "$uname" "$ip_list" \
                                              "$db_table" "$db_ip_col" "$db_user_col" "$db_pass_col")
            local detect_rc=$?
            log INFO "  Detected format: ${fmt}"

            if [[ "$fmt" == "NOT_FOUND" ]]; then
                log WARN "  username/ip not found on ${db_s} -- skipping"
                for ip in $ip_list; do
                    append_result "$ip" "$uname" "$db_s" "$db_n" "UNKNOWN" "SKIPPED" "username/ip not found in ${db_table}"
                    skipped=$((skipped + 1))
                done
                SRV_LOG_FILE=""; continue
            fi

            if [[ "$fmt" == "UNKNOWN" || $detect_rc -ne 0 ]]; then
                log ERROR "  Format detection failed on ${db_s}"
                for ip in $ip_list; do
                    append_result "$ip" "$uname" "$db_s" "$db_n" "UNKNOWN" "FAILED" "DB format detection failed"
                    failed=$((failed + 1))
                done
                SRV_LOG_FILE=""; continue
            fi

            local resolved db_new_pw db_old_pw
            resolved=$(resolve_passwords "$fmt" "$user_old_pw" "$user_new_pw")
            db_new_pw=$(echo "$resolved" | sed -n '1p')
            db_old_pw=$(echo "$resolved" | sed -n '2p')

            log INFO "  Running batched UPDATE for ${ip_count} IP(s) ..."
            update_password_batch_mode_a "$db_s" "$ssh_u" "$ssh_p" "$db_u" "$db_p" "$db_n" \
                                          "$uname" "$db_new_pw" "$ip_list" \
                                          "$db_table" "$db_ip_col" "$db_user_col" "$db_pass_col"  # CHANGE-4
            local upd_rc=$?

            if [[ $upd_rc -ne 0 ]]; then
                log ERROR "  Batched UPDATE failed (rc=${upd_rc})"
                for ip in $ip_list; do
                    append_result "$ip" "$uname" "$db_s" "$db_n" "$fmt" "FAILED" "Batched UPDATE failed rc=${upd_rc}"
                    failed=$((failed + 1))
                done
                SRV_LOG_FILE=""; continue
            fi

            local verify_result verified_count total_count
            verify_result=$(verify_batch_mode_a "$db_s" "$ssh_u" "$ssh_p" "$db_u" "$db_p" "$db_n" \
                                                 "$uname" "$db_new_pw" "$ip_list" \
                                                 "$db_table" "$db_ip_col" "$db_user_col" "$db_pass_col")  # CHANGE-4
            verified_count=$(echo "$verify_result" | cut -d: -f1)
            total_count=$(echo "$verify_result"    | cut -d: -f2)

            # CHANGE-15: per-IP granular result instead of all-or-nothing
            if [[ "${verified_count:-0}" -gt 0 ]]; then
                if [[ "$verified_count" -eq "$total_count" ]]; then
                    log OK "  [MODE A] Fully verified: ${verified_count}/${total_count} IPs on ${db_s}/${db_n}"
                    for ip in $ip_list; do
                        append_result "$ip" "$uname" "$db_s" "$db_n" "$fmt" "SUCCESS" \
                                      "MODE A: updated and verified"
                        success=$((success + 1))
                    done
                else
                    log WARN "  [MODE A] Partial: ${verified_count}/${total_count} IPs on ${db_s}/${db_n}"
                    # Query each IP individually to give accurate per-IP status
                    for ip in $ip_list; do
                        local norm_chk; norm_chk=$(normalise_ipv6 "$ip")
                        local chk_sql chk_out chk_count
                        chk_sql="SELECT COUNT(*) FROM \`${db_table}\` WHERE \`${db_user_col}\`='$(sql_escape "$uname")' AND \`${db_pass_col}\`='$(sql_escape "$db_new_pw")' AND \`${db_ip_col}\` IN ('$(sql_escape "$norm_chk")', '$(sql_escape "$ip")');";
                        chk_out=$(run_remote_mysql "$db_s" "$ssh_u" "$ssh_p" \
                                                    "$db_u" "$db_p" "$db_n" \
                                                    "$chk_sql" 2>/dev/null)
                        chk_count=$(echo "$chk_out" | grep -v -i '^count' | grep -v '^$' | head -1 | tr -d '\r\n ')
                        if [[ "$chk_count" =~ ^[0-9]+$ ]] && (( chk_count > 0 )); then
                            log OK   "  [MODE A] ✓ ${ip} -- updated"
                            append_result "$ip" "$uname" "$db_s" "$db_n" "$fmt" "SUCCESS" \
                                          "MODE A: updated (partial group -- this IP ok)"
                            success=$((success + 1))
                        else
                            log WARN "  [MODE A] ✗ ${ip} -- NOT updated"
                            append_result "$ip" "$uname" "$db_s" "$db_n" "$fmt" "PARTIAL" \
                                          "MODE A: other IPs in group updated but this IP not found/updated"
                            failed=$((failed + 1))
                        fi
                    done
                fi
            else
                log ERROR "  Verification failed: 0 rows updated"
                for ip in $ip_list; do
                    append_result "$ip" "$uname" "$db_s" "$db_n" "$fmt" "FAILED" "MODE A: UPDATE ran but 0 rows verified"
                    failed=$((failed + 1))
                done
            fi

            SRV_LOG_FILE=""
        done
    done

    # ===========================================================
    # PROCESS MODE B
    # ===========================================================
    for row in "${MODE_B_ROWS[@]:-}"; do
        [[ -z "$row" ]] && continue
        local uname user_old_pw user_new_pw
        IFS='|' read -r uname user_old_pw user_new_pw <<< "$row"
        total=$((total + 1))

        log INFO "============================================================"
        log INFO "[MODE B] username='${uname}'  (match by old password)"

        for i in "${!SRV_IP[@]}"; do
            local db_s="${SRV_IP[$i]}"
            local ssh_u="${SRV_SSH_U[$i]}"  ssh_p="${SRV_SSH_P[$i]}"
            local db_u="${SRV_DB_U[$i]}"    db_p="${SRV_DB_P[$i]}"
            local db_n="${SRV_DB_N[$i]}"
            # CHANGED: read db_type and port
            local cur_db_type="${SRV_DB_TYPE[$i]:-mysql}"
            local cur_db_port="${SRV_DB_PORT[$i]:-3306}"
            SRV_LOG_FILE="${SRV_LOG[$i]}"

            # CHANGE-2: resolve table/col config
            local cfg db_type_resolved db_table db_ip_col db_user_col db_pass_col
            cfg=$(get_db_config "$cur_db_type" "$db_n")
            db_type_resolved=$(echo "$cfg" | sed -n '1p')
            db_table=$(echo "$cfg"         | sed -n '2p')
            db_ip_col=$(echo "$cfg"        | sed -n '3p')
            db_user_col=$(echo "$cfg"      | sed -n '4p')
            db_pass_col=$(echo "$cfg"      | sed -n '5p')

            log INFO "  DB Server: ${db_s}  |  DB: ${db_n}  |  Type: ${db_type_resolved}  |  Table: ${db_table}"

            if [[ "${SSH_UP[$i]}" == "0" ]]; then
                log WARN "  Skipping -- SSH unavailable for ${db_s}"
                append_result "NA" "$uname" "$db_s" "$db_n" "UNKNOWN" "SKIPPED" "SSH failed"
                skipped=$((skipped + 1))
                SRV_LOG_FILE=""; continue
            fi

            # ── dispatch mysql vs postgres ────────────────────
            if [[ "$db_type_resolved" == "postgres" ]]; then
                # ── PostgreSQL MODE B ─────────────────────────
                # CHANGE-19: SSH credentials passed to all pg_* calls
                log INFO "  [PostgreSQL] Detecting format (SSH → psql) ..."
                local fmt
                fmt=$(pg_detect_format "$db_s" "$ssh_u" "$ssh_p" \
                                       "$db_n"  "$db_u"  "$db_p" \
                                       "$db_table" "$db_ip_col" "$db_user_col" "$db_pass_col" \
                                       "$uname" "" "$cur_db_port")
                log INFO "  Detected format: ${fmt}"

                if [[ "$fmt" == "NOT_FOUND" ]]; then
                    log WARN "  username='${uname}' not found on ${db_s} -- skipping"
                    append_result "NA" "$uname" "$db_s" "$db_n" "UNKNOWN" "SKIPPED" "user not found in ${db_table}"
                    skipped=$((skipped + 1))
                    SRV_LOG_FILE=""; continue
                fi

                if [[ "$fmt" == "UNKNOWN" ]]; then
                    log ERROR "  Format detection failed on ${db_s}"
                    append_result "NA" "$uname" "$db_s" "$db_n" "UNKNOWN" "FAILED" "PG format detection failed"
                    failed=$((failed + 1))
                    SRV_LOG_FILE=""; continue
                fi

                local resolved db_new_pw db_old_pw
                resolved=$(resolve_passwords "$fmt" "$user_old_pw" "$user_new_pw")
                db_new_pw=$(echo "$resolved" | sed -n '1p')
                db_old_pw=$(echo "$resolved" | sed -n '2p')

                # Pre-check via SSH
                local match_count
                match_count=$(pg_check_rows_by_old_pw "$db_s" "$ssh_u" "$ssh_p" \
                                                       "$db_n"  "$db_u"  "$db_p" \
                                                       "$db_table" "$db_user_col" "$db_pass_col" \
                                                       "$uname" "$db_old_pw" "$cur_db_port")
                log INFO "  Pre-check rows matching old password: ${match_count}"

                if [[ "$match_count" == "0" || -z "$match_count" ]]; then
                    log WARN "  No rows matched username+old_password -- skipping"
                    append_result "NA" "$uname" "$db_s" "$db_n" "$fmt" "SKIPPED" "PG MODE B: 0 rows matched"
                    skipped=$((skipped + 1))
                    SRV_LOG_FILE=""; continue
                fi

                local pg_out
                pg_out=$(pg_update_remote "$db_s" "$ssh_u" "$ssh_p" \
                                          "$db_n"  "$db_u"  "$db_p" \
                                          "$db_table" "$db_ip_col" "$db_user_col" "$db_pass_col" \
                                          "" "$uname" "$db_new_pw" "$db_old_pw" "B" "$cur_db_port" 2>&1)

                if echo "$pg_out" | grep -qiE "UPDATE [1-9]"; then
                    if pg_verify_mode_b "$db_s" "$ssh_u" "$ssh_p" \
                                        "$db_n"  "$db_u"  "$db_p" \
                                        "$db_table" "$db_user_col" "$db_pass_col" \
                                        "$uname" "$db_new_pw" "$cur_db_port"; then
                        log OK "  [PG MODE B] ✓ Updated & verified ${match_count} row(s) on ${db_s}/${db_n}"
                        append_result "NA" "$uname" "$db_s" "$db_n" "$fmt" "SUCCESS" \
                                      "PG MODE B: updated ${match_count} row(s)"
                        success=$((success + 1))
                    else
                        log ERROR "  [PG MODE B] UPDATE ran but verify failed"
                        append_result "NA" "$uname" "$db_s" "$db_n" "$fmt" "FAILED" "PG MODE B: verify failed"
                        failed=$((failed + 1))
                    fi
                else
                    log ERROR "  [PG MODE B] FAILED: $(echo "$pg_out" | tail -1)"
                    append_result "NA" "$uname" "$db_s" "$db_n" "$fmt" "FAILED" \
                                  "PG MODE B: $(sanitize_ascii "$(echo "$pg_out" | tail -1)")"
                    failed=$((failed + 1))
                fi
                SRV_LOG_FILE=""; continue
            fi

            # ── MySQL / MariaDB MODE B ────────────────────────
            log INFO "  Detecting DB storage format for '${uname}' ..."
            local fmt
            fmt=$(detect_db_format "$db_s" "$ssh_u" "$ssh_p" "$db_u" "$db_p" "$db_n" \
                                    "$uname" "" \
                                    "$db_table" "$db_ip_col" "$db_user_col" "$db_pass_col")  # CHANGE-4
            local detect_rc=$?
            log INFO "  Detected format: ${fmt}"

            if [[ "$fmt" == "NOT_FOUND" ]]; then
                log WARN "  username='${uname}' not found on ${db_s} -- skipping"
                append_result "NA" "$uname" "$db_s" "$db_n" "UNKNOWN" "SKIPPED" "user not found in ${db_table}"
                skipped=$((skipped + 1))
                SRV_LOG_FILE=""; continue
            fi

            if [[ "$fmt" == "UNKNOWN" || $detect_rc -ne 0 ]]; then
                log ERROR "  Format detection failed on ${db_s}"
                append_result "NA" "$uname" "$db_s" "$db_n" "UNKNOWN" "FAILED" "DB format detection failed"
                failed=$((failed + 1))
                SRV_LOG_FILE=""; continue
            fi

            local resolved db_new_pw db_old_pw
            resolved=$(resolve_passwords "$fmt" "$user_old_pw" "$user_new_pw")
            db_new_pw=$(echo "$resolved" | sed -n '1p')
            db_old_pw=$(echo "$resolved" | sed -n '2p')

            local match_count
            match_count=$(check_rows_affected_by_old_pw "$db_s" "$ssh_u" "$ssh_p" \
                            "$db_u" "$db_p" "$db_n" "$uname" "$db_old_pw" \
                            "$db_table" "$db_user_col" "$db_pass_col")  # CHANGE-4
            log INFO "  Rows matching old password: ${match_count}"

            if [[ "$match_count" == "0" || -z "$match_count" ]]; then
                log WARN "  No rows matched username+old_password -- skipping"
                append_result "NA" "$uname" "$db_s" "$db_n" "$fmt" "SKIPPED" "no rows matched username+old_password"
                skipped=$((skipped + 1))
                SRV_LOG_FILE=""; continue
            fi

            update_password_by_old_pw "$db_s" "$ssh_u" "$ssh_p" "$db_u" "$db_p" "$db_n" \
                                       "$uname" "$db_new_pw" "$db_old_pw" \
                                       "$db_table" "$db_user_col" "$db_pass_col"  # CHANGE-4
            local upd_rc=$?

            if [[ $upd_rc -ne 0 ]]; then
                log ERROR "  UPDATE failed (rc=${upd_rc})"
                append_result "NA" "$uname" "$db_s" "$db_n" "$fmt" "FAILED" "MODE B: UPDATE failed rc=${upd_rc}"
                failed=$((failed + 1))
                SRV_LOG_FILE=""; continue
            fi

            if verify_password_by_uname "$db_s" "$ssh_u" "$ssh_p" "$db_u" "$db_p" "$db_n" \
                                         "$uname" "$db_new_pw" \
                                         "$db_table" "$db_user_col" "$db_pass_col"; then  # CHANGE-4
                log OK "  [MODE B] Updated ${match_count} row(s) & verified -- ${db_s}/${db_n}"
                append_result "NA" "$uname" "$db_s" "$db_n" "$fmt" "SUCCESS" \
                              "MODE B: updated ${match_count} row(s)"
                success=$((success + 1))
            else
                log ERROR "  [MODE B] UPDATE ran but verify failed"
                append_result "NA" "$uname" "$db_s" "$db_n" "$fmt" "FAILED" "MODE B: verify failed"
                failed=$((failed + 1))
            fi

            SRV_LOG_FILE=""
        done
    done

    log INFO "========================================================"
    log INFO " SUMMARY"
    log INFO "  Total  : ${total}"
    log OK   "  Success: ${success}"
    log WARN "  Skipped: ${skipped}"
    [[ $failed -gt 0 ]] && log ERROR "  Failed : ${failed}" || log INFO "  Failed : ${failed}"
    log INFO "  Output : ${RESULT_CSV}"
    log INFO "  Log    : ${LOG_FILE}"
    log INFO "========================================================"

    [[ -f "${RESULT_CSV}" ]] && exit 0 || { log ERROR "Output CSV not created."; exit 1; }
}

main "$@"

